# Copy this file to .env.local and fill in your own values.
#
# Required: live quotes and symbol search.
# Get a free key at https://finnhub.io/register
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: historical candles for charts and sparklines. Finnhub's
# /stock/candle endpoint is premium-only on the free tier, so we use
# Twelve Data (800 credits/day free) as a secondary provider.
# If unset, charts fall back to demo data and sparklines are hidden.
# Get a free key at https://twelvedata.com/pricing
VITE_TWELVE_DATA_API_KEY=
